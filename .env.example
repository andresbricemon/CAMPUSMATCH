# Copia este archivo como .env y completa los valores de tu proyecto Firebase
# (Consola de Firebase > Configuración del proyecto > Tus apps > App web).
# Si .env no existe, la app corre en "modo demo" sin login real.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Dominio de correo permitido para iniciar sesión
VITE_ALLOWED_DOMAIN=unimilitar.edu.co
